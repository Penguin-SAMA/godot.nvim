# Track the plugin and the sources needed to rebuild its bundled font.
*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md

!/plugin/
!/plugin/*.lua
!/lua/
!/lua/godot/
!/lua/godot/*.lua
!/lua/godot/shader_overloads.gdshaderinc

!/addons/
!/addons/nvim_bridge/
!/addons/nvim_bridge/plugin.cfg
!/addons/nvim_bridge/*.gd
!/scripts/
!/scripts/godot-nvim-open.lua
!/scripts/resolve_uid.gd
!/scripts/install-windows-font.ps1
!/scripts/install-windows-tool.ps1
!/scripts/dependencies-windows.json
!/scripts/assets/
!/scripts/assets/godot_resource.dll
!/scripts/assets/godot_resource-LICENSE.txt
!/scripts/assets/README.md

!/fonts/
!/fonts/GodotSceneIcons.ttf
!/fonts/GODOT-LICENSE.txt
!/fonts/generate.py
!/fonts/requirements.txt
!/fonts/README.md

!/tests/
!/tests/engine.lua
!/tests/feature_config.lua
!/tests/feature_integration.lua
!/tests/tools.lua
!/tests/install-windows-tool.ps1
!/tests/shader_compat.lua

